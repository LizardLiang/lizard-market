{
  "name": "kratos-test-harness",
  "version": "1.0.0",
  "description": "Node.js SDK test harness for Kratos plugin performance evaluation",
  "type": "module",
  "scripts": {
    "test": "node src/run.mjs",
    "test:implementation": "node src/run.mjs --task implementation",
    "test:debug": "node src/run.mjs --task debug",
    "test:research-metis": "node src/run.mjs --task research-metis",
    "test:research-mimir": "node src/run.mjs --task research-mimir",
    "test:research-clio": "node src/run.mjs --task research-clio",
    "test:brainstorming": "node src/run.mjs --task brainstorming",
    "test:timestamps": "node src/run.mjs --task timestamp-athena timestamp-nemesis timestamp-hephaestus timestamp-apollo timestamp-artemis timestamp-ares timestamp-hermes",
    "validate:authenticity": "node src/authenticity-validator.mjs",
    "test:cli-compliance": "node src/run.mjs --task cli-compliance-athena,cli-compliance-nemesis,cli-compliance-hephaestus,cli-compliance-apollo,cli-compliance-artemis,cli-compliance-ares,cli-compliance-hera,cli-compliance-hermes,cli-compliance-cassandra",
    "test:cli-compliance-athena": "node src/run.mjs --task cli-compliance-athena",
    "test:cli-compliance-nemesis": "node src/run.mjs --task cli-compliance-nemesis",
    "test:cli-compliance-hephaestus": "node src/run.mjs --task cli-compliance-hephaestus",
    "test:cli-compliance-apollo": "node src/run.mjs --task cli-compliance-apollo",
    "test:cli-compliance-artemis": "node src/run.mjs --task cli-compliance-artemis",
    "test:cli-compliance-ares": "node src/run.mjs --task cli-compliance-ares",
    "test:cli-compliance-hera": "node src/run.mjs --task cli-compliance-hera",
    "test:cli-compliance-hermes": "node src/run.mjs --task cli-compliance-hermes",
    "test:cli-compliance-cassandra": "node src/run.mjs --task cli-compliance-cassandra",
    "validate:cli-compliance": "node src/cli-compliance-validator.mjs",
    "test:ares-discover": "node src/run.mjs --task ares-discover-setup,ares-discover-run",
    "test:hephaestus-dispatch": "node src/test-hephaestus-dispatch.mjs",
    "test:inline-commands": "node src/test-inline-commands.mjs",
    "test:inline-commands:quick": "node src/test-inline-commands.mjs --agent athena,hermes,hades,ares"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0"
  }
}
